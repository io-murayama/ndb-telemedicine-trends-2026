# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user
.Rprofile.local

# renv (keep project hooks; ignore library)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# data & outputs (regenerable; keep directory via .gitkeep)
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
output/*
!output/.gitkeep
!output/logs/
output/logs/*
!output/logs/.gitkeep
!output/tables/
output/tables/*
!output/tables/.gitkeep
!output/intermediate/
output/intermediate/*
!output/intermediate/.gitkeep
!output/figures/
output/figures/*
!output/figures/.gitkeep
!output/reports/
output/reports/*
!output/reports/.gitkeep

# OS / editor
.DS_Store
*~
*.swp
.idea/
.vscode/

# misc
*.html
*.log
.Rcheck/
*-Ex.R
/*.tar.gz
/*.Rcheck
