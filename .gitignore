# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj.user
.Rprofile.local

# renv (keep project hooks; ignore library)
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
