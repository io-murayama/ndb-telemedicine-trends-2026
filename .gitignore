# data (regenerable; keep directory via .gitkeep)
data/*
!data/.gitkeep
!data/reference/
!data/reference/**
!data/raw/
data/raw/*
!data/raw/.gitkeep

# OS / editor
.DS_Store
*~
*.swp
.idea/
.vscode/

# misc
*.html
!output/reports/*.html
*.log
.Rcheck/
*-Ex.R
/*.tar.gz
/*.Rcheck
